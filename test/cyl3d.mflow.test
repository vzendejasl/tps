#!./bats
# -*- mode: sh -*-

TEST="cyl3d.mflow.outlet"
RUNFILE="inputs/input.2iters.mflow.cyl.ini"
BULK_RUNFILE="inputs/input.2iters.mflow.bulkVisc.dtconst.cyl.ini"

setup() {
    SOLN_FILE=restart_output.sol.h5
    REF_FILE=ref_solns/cyl3d.mflow.2iters.h5
    REF_BULK_FILE=ref_solns/cyl3d.mflow.2iters.bulkVisc.dtconst.h5

    local mfem_dir
    mfem_dir=$(awk -F' = ' '/^MFEM_DIR = / { print $2; exit }' Makefile)
    if [ "$(./snarf_mfem.py --version --dir "$mfem_dir")" -ge 40900 ]; then
        REF_FILE=ref_solns/cyl3d.mflow.2iters.v49.h5
        REF_BULK_FILE=ref_solns/cyl3d.mflow.2iters.bulkVisc.dtconst.v49.h5
    fi
}

@test "[$TEST] check for input file $RUNFILE" {
    test -s $RUNFILE
}

@test "[$TEST] verify outlet area calculation with input -> $RUNFILE" {
    rm -f $SOLN_FILE
    run ../src/tps --runFile $RUNFILE

    [[ "${output}" =~ "[OUTLET]: Total Surface Area                = 0.00978" ]]

    test -s $SOLN_FILE
}

@test "[$TEST] verify tps output with input -> $RUNFILE" {

    test -s $SOLN_FILE
    test -s $REF_FILE
    ./soln_differ $SOLN_FILE $REF_FILE
}


@test "[$TEST] verify tps output with input -> $BULK_RUNFILE" {
    rm -f $SOLN_FILE
    test -s $BULK_RUNFILE
    run ../src/tps --runFile $BULK_RUNFILE

    test -s $SOLN_FILE
    test -s $REF_BULK_FILE
    ./soln_differ $SOLN_FILE $REF_BULK_FILE
}
